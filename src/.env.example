# a ".env.example" file is used so that, if a person tries to use the project, they can do so
#, while I keep private info in the ".env" file which is ignored by git

APP_NAME="mini-rag"
APP_VERSION="0.1"
OPENAI_API_KEY="" 

FILE_ALLOWED_EXTENSIONS=[]
FILE_MAX_SIZE=10 # x MBs
FILE_DEFAULT_CHUNK_SIZE=512000 # 512 KBs