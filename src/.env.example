# a ".env.example" file is used so that, if a person tries to use the project, they can do so
#, while I keep private info in the ".env" file which is ignored by git

APP_NAME="mini-rag"
APP_VERSION="0.1"

FILE_ALLOWED_EXTENSIONS=
FILE_MAX_SIZE=10 # 10 MBs
FILE_DEFAULT_CHUNK_SIZE=512000 # 512 KBs

# ---------------------------------------- DB ---------------------------------------- 
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_MAIN_DATABASE="minirag"

# ---------------------------------------- LLM ---------------------------------------- 
GENERATION_BACKEND=
EMBEDDING_BACKEND=

OPENAI_API_KEY="" 
OPENAI_API_URL=
COHERE_API_KEY=""

QWEN_API_KEY=""
QWEN_API_URL=""

GENERATION_MODEL_ID=
EMBDEDING_MODEL_ID=
EMBDEDING_MODEL_SIZE=

GENERATION_DEFUALT_TEMPERATURE= 1.0
DEFUALT_GENERATION_MAX_CHAR= 1000
DEFAULT_INPUT_MAX_CHAR=1000

# ---------------------------------------- VectorDB ---------------------------------------- 
VECTOR_DB_BACKEND = 'QDRANT'
VECTOR_DB_PATH = 'quadrant_db'
VECTOR_DB_DISTANCE_METHOD = 'cosine'

# ---------------------------------------- Templates ---------------------------------------- 
DEFUALT_LANGUAGE = 'en'